#!/usr/bin/env bash
# Regole del progetto: ogni commit aggiorna versione, CHANGELOG e documentazione.
set -e
fail() { echo "pre-commit: $1" >&2; exit 1; }

staged="$(git diff --cached --name-only)"
[ -z "$staged" ] && exit 0

ver="$(tr -d '[:space:]' < VERSION)"
sv="$(node -p "require('./server/package.json').version")"
wv="$(node -p "require('./web/package.json').version")"
dv="$(node -p "require('./desktop/package.json').version")"
[ "$ver" = "$sv" ] && [ "$ver" = "$wv" ] && [ "$ver" = "$dv" ] || fail "VERSION ($ver), server ($sv), web ($wv) e desktop ($dv) non coincidono. Usa: node scripts/bump-version.mjs <x.y.z>"

grep -q "^## \[$ver\]" CHANGELOG.md || fail "CHANGELOG.md non ha la sezione '## [$ver]'"
echo "$staged" | grep -qx "CHANGELOG.md" || fail "CHANGELOG.md non e' tra i file in commit"
echo "$staged" | grep -q "^docs/" || fail "nessun file in docs/ aggiornato: la documentazione va tenuta allineata ad ogni commit"

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  old="$(git show HEAD:VERSION 2>/dev/null | tr -d '[:space:]' || true)"
  [ "$old" != "$ver" ] || fail "la versione non e' cambiata rispetto a HEAD ($ver): incrementala"
fi
exit 0
