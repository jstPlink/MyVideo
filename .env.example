# Porta esposta sul NAS (la app dentro il container ascolta sempre su 8080)
HOST_PORT=8099

# Link di condivisione Seafile con la libreria video (OBBLIGATORIO)
SEAFILE_URL=https://seafile.example.com/d/xxxxxxxxxxxxxxxxxxxx/

# Chiave API TMDB (gratuita) per locandine, trame e sfondi. Si puo' impostare anche dal pannello Admin
TMDB_API_KEY=

# Registrazioni dopo il primo utente (admin): approval = serve approvazione admin, open = aperte, closed = chiuse
REGISTRATION=approval

# Segreto per i token di login. Se vuoto viene generato e salvato nel database
JWT_SECRET=

# Rescansione automatica della libreria, in ore (0 = disattivata)
SCAN_INTERVAL_HOURS=1
