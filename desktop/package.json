{
  "name": "myvideo-desktop",
  "version": "0.7.0",
  "description": "MyVideo - app desktop",
  "author": "fplinio",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.mjs",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "it.fplinio.myvideo.desktop",
    "productName": "MyVideo",
    "artifactName": "MyVideo-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "pages/**/*",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "MyVideo-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyVideo"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
